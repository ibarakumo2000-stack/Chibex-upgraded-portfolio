{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for E-tech Visuals client portal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created"
        }
      },
      "required": ["id", "email"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Scheduled free 30-minute creative consultation call",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking document ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who booked"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the client"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Client email for calendar invite"
        },
        "serviceInterest": {
          "type": "string",
          "maxLength": 100,
          "description": "Design service client is interested in"
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "description": "Selected consultation date (YYYY-MM-DD)"
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 20,
          "description": "Selected consultation time slot (e.g. 14:00 GMT)"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Project goals and briefing notes"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "completed", "cancelled"],
          "description": "Current status of the booking"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Booking submission timestamp"
        }
      },
      "required": ["id", "userId", "userEmail", "serviceInterest", "date", "timeSlot", "status"]
    },
    "SavedProject": {
      "title": "SavedProject",
      "description": "Bookmarked portfolio project in client moodboard",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique saved project document ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who saved the project"
        },
        "projectId": {
          "type": "string",
          "maxLength": 100,
          "description": "Portfolio project identifier"
        },
        "projectTitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Title of the saved project"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Category of the saved project"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Thumbnail or preview image URL"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Client personal notes or creative references"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when project was bookmarked"
        }
      },
      "required": ["id", "userId", "projectId", "projectTitle", "category"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Design project quote request or direct inquiry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique inquiry document ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of the submitting user or anonymous lead"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Contact person name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email"
        },
        "service": {
          "type": "string",
          "maxLength": 100,
          "description": "Requested design service"
        },
        "budget": {
          "type": "string",
          "maxLength": 50,
          "description": "Estimated budget tier"
        },
        "timeline": {
          "type": "string",
          "maxLength": 50,
          "description": "Project timeline"
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Project brief and details"
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "archived"],
          "description": "Status of the inquiry"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": ["id", "name", "email", "service", "message"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Cookie-consented visitor and user activity tracking log for studio admin insights",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique activity log document ID"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 100,
          "description": "Browser session identifier"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional user UID if authenticated"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional user email if authenticated"
        },
        "action": {
          "type": "string",
          "maxLength": 100,
          "description": "Action category (e.g., page_view, view_project, bookmark_project, booking_click, inquiry_submit)"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Description of the specific action or asset interacted with"
        },
        "page": {
          "type": "string",
          "maxLength": 100,
          "description": "URL path visited"
        },
        "referrer": {
          "type": "string",
          "maxLength": 300,
          "description": "Document referrer"
        },
        "device": {
          "type": "string",
          "maxLength": 50,
          "description": "Visitor device category (Desktop/Mobile/Tablet)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when action occurred"
        }
      },
      "required": ["id", "sessionId", "action", "page", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual client user profile documents"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Creative consultation calls scheduled with E-tech Visuals"
    },
    "/savedProjects/{saveId}": {
      "schema": "SavedProject",
      "description": "Projects bookmarked into client moodboard"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Project quote and custom inquiries"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Consented user and visitor engagement logs viewable by studio administrators"
    }
  }
}
