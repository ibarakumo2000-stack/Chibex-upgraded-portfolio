# E-Tech Graphics — Environment Variables Template
# Copy this file to .env for local development

# PORT: Server port (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# --- CONTACT FORM EMAIL INTEGRATION (RESEND) ---
# Optional in development (the app uses a safe development fallback logger).
# Required in production to receive live client inquiries.
# 1. Sign up at https://resend.com and obtain an API key (format: re_xxxxxxx)
# 2. Verify your custom sending domain in Resend.
RESEND_API_KEY="replace_me"

# The destination email address where client inquiry notifications should be sent
CONTACT_TO_EMAIL="emperorstech885@gmail.com"

# The verified sending address configured in your Resend account (e.g. hello@yourverifieddomain.com)
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# --- BOOKING & SCHEDULING (CALENDLY / CAL.COM) ---
# Optional: Set your real 30-minute booking URL (e.g. https://calendly.com/your-username/30min)
# If empty, the website shows a clear setup modal with contact options.
VITE_BOOKING_URL=""
NEXT_PUBLIC_BOOKING_URL=""

# --- WHATSAPP DIRECT MESSAGE ---
# Business phone number in international format without symbols (e.g. 2347038373011)
VITE_WHATSAPP_NUMBER="2347038373011"
NEXT_PUBLIC_WHATSAPP_NUMBER="2347038373011"
